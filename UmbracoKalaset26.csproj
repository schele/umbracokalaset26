<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ColorCode.HTML" />
    <PackageReference Include="Esatto.Umbraco.Backoffice.AICosts" />
    <PackageReference Include="Esatto.Umbraco.Backoffice.BlockPreview" />
    <PackageReference Include="Esatto.Umbraco.Backoffice.CustomEditors" />
    <PackageReference Include="Esatto.Umbraco.Backoffice.DictionaryFilterValues" />
    <PackageReference Include="Esatto.Umbraco.Backoffice.Redirects" />
    <PackageReference Include="Esatto.Umbraco.Backoffice.SharedPreviewLink" />
    <PackageReference Include="Esatto.Umbraco.Backoffice.TreeDragAndDrop" />
    <PackageReference Include="Umbraco.AI" />
    <PackageReference Include="Umbraco.AI.Anthropic" />
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
    <PackageReference Include="uSync" />
  </ItemGroup>

  <ItemGroup Label="Security overrides">
    <!-- System.Security.Cryptography.Pkcs 10.0.0 (transitive via Umbraco): DoS, CVE-2026-84008
         (GHSA-846f-f764-76mx), fixed 10.0.13. Remove once Umbraco depends on a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms.
      Default mirrors prior behaviour introduced in https://github.com/umbraco/Umbraco-CMS/pull/11276: enabled unless building on macOS without an explicit RuntimeIdentifier.
      To override:
        * Build/publish:  dotnet publish -p:UmbracoUseAppLocalIcu=false
        * Post-publish:   edit System.Globalization.AppLocalIcu in the published *.runtimeconfig.json
      Note: DOTNET_SYSTEM_GLOBALIZATION_APPLOCALICU is only honored when AppLocalIcu is absent from runtimeconfig.json
      (verified on .NET 10) — the general .NET 9 env-var-precedence rule does not apply to this knob, since it is
      resolved by the native host before the CLR boots. Use one of the two override paths above instead.
      Keep UmbracoAppLocalIcuVersion in sync with the referenced Microsoft.ICU.ICU4C.Runtime package version.
    -->
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == '' and ($(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx'))))">true</UmbracoUseAppLocalIcu>
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == ''">false</UmbracoUseAppLocalIcu>
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UmbracoUseAppLocalIcu)' == 'true'">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="$(UmbracoAppLocalIcuVersion)" />
  </ItemGroup>


  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!--
      SixLabors.ImageSharp 3.1.12 advisories, only patched in 4.1.2+. Umbraco 18.2.1 (Umbraco.Cms.Imaging.ImageSharp,
      Umbraco.AI.Core) requires ImageSharp < 4: pinning 4.x fails at startup (TypeLoadException) or on every image
      request (MissingMethodException). Remove these once Umbraco ships on ImageSharp 4.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the local appsettings.json override out of publish output -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
