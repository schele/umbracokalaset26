<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="a52e0a88-fbe4-4c76-a9cd-8532cdf0a57b" Alias="graphBlock" Level="2">
  <Info>
    <Name>Graph Block</Name>
    <Icon>icon-chart-curve</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>A chart of the AI usage costs (Esatto AI Costs), drawn on the server.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Blocks</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
    <AllowedInLibrary>false</AllowedInLibrary>
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>b40842fc-3c35-45d6-8fa9-ba04ec410d1a</Key>
      <Name>Title</Name>
      <Alias>title</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Optional heading above the chart.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab></Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>babf3037-c098-435e-830d-41190aa25634</Key>
      <Name>Chart</Name>
      <Alias>chart</Alias>
      <Definition>41ee3810-31c0-44a1-b493-45b51ae1cb63</Definition>
      <Type>Umbraco.RadioButtonList</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Column (default), line, area or donut. A donut shows the period as shares of a whole.]]></Description>
      <SortOrder>1</SortOrder>
      <Tab></Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>1d3e4e14-5d77-4802-be74-23a609bff101</Key>
      <Name>Measure</Name>
      <Alias>measure</Alias>
      <Definition>785fdac6-6c27-44d2-9558-57915a1122d5</Definition>
      <Type>Umbraco.RadioButtonList</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[What to chart. Default: cost.]]></Description>
      <SortOrder>2</SortOrder>
      <Tab></Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>e8c10bad-7a1d-40aa-8734-e86ba3cc7a31</Key>
      <Name>Split by</Name>
      <Alias>splitBy</Alias>
      <Definition>da6101c6-ae1f-4ccd-b3dc-4a4a19cdd60c</Definition>
      <Type>Umbraco.RadioButtonList</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Default: total. Over time, only cost can be split by model; profile and provider are shown as a donut (other charts show the total).]]></Description>
      <SortOrder>3</SortOrder>
      <Tab></Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>32a67eb2-5c01-4653-86c0-f60a5a25659c</Key>
      <Name>Period</Name>
      <Alias>period</Alias>
      <Definition>0fb7a4be-9243-43a7-a6a4-2064d97d4e9a</Definition>
      <Type>Umbraco.RadioButtonList</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Up to 30 days per day, up to 180 days per week, 12 months per month. Default: 30 days.]]></Description>
      <SortOrder>4</SortOrder>
      <Tab></Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>29e81f48-bc3c-424b-98aa-1dbb3cb6829f</Key>
      <Name>Currency</Name>
      <Alias>currency</Alias>
      <Definition>bb7b4bc1-8ec9-499c-8aa9-c436e0eaba55</Definition>
      <Type>Umbraco.RadioButtonList</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Default: the currency set in Esatto:AICosts. Needs exchange rates (ECB) for anything but the base currency.]]></Description>
      <SortOrder>5</SortOrder>
      <Tab></Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>c6ae55fe-5b0d-438c-aca7-66c442194273</Key>
      <Name>Full width</Name>
      <Alias>fullWidth</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Run the block edge to edge. Off: centred at the page's content width.]]></Description>
      <SortOrder>6</SortOrder>
      <Tab></Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs />
</ContentType>