        },
        {
          "alias": "code",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "public static class StringExtensions\n{\n    /// \u003Csummary\u003EShortens text to at most \u003Cparamref name=\u0022maxLength\u0022/\u003E characters, ending on a whole word.\u003C/summary\u003E\n    public static string Truncate(this string text, int maxLength)\n    {\n        if (string.IsNullOrEmpty(text) || text.Length \u003C= maxLength)\n        {\n            return text;\n        }\n\n        var cut = text.LastIndexOf(\u0027 \u0027, maxLength);\n        return text[..(cut \u003E 0 ? cut : maxLength)].TrimEnd() + \u0022…\u0022;\n    }\n}"
        }
      ]
    }
  ],
