      <Value Culture="en-GB"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "1f28892b-ff95-4cd8-b3e7-db0f0487bda1",
      "key": "66ac9804-8b09-4f02-95c3-eaf93956f062",
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "About this site"
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "4dfe42ed-2575-46e8-9764-efc1a5860832",
                "key": "f07f6f27-c5a7-4ffd-b1bd-ab476a82a605",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "What is this site built with?"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "\u003Cp\u003EIt runs on \u003Cstrong\u003EUmbraco 18\u003C/strong\u003E with the Block List editor. Every section of this page is a block that an editor can add, move or remove in the backoffice.\u003C/p\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "4dfe42ed-2575-46e8-9764-efc1a5860832",
                "key": "843858b0-0100-47fd-b77b-c8327efe128f",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Which blocks can I use?"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "\u003Cp\u003EThere are blocks for the most common content:\u003C/p\u003E\u003Cul\u003E\u003Cli\u003E\u003Cp\u003ECarousel, video and portrait\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003ERich text, quote and accordion\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003ECode, graph and script\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "4dfe42ed-2575-46e8-9764-efc1a5860832",
                "key": "ded5bd46-d7fd-4da6-a764-4ef66ad932c6",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Can a block span the whole page?"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "\u003Cp\u003EYes. Every block except the carousel has a \u003Cem\u003EFull width\u003C/em\u003E toggle. When it is off, the block is centred at the page\u0027s content width.\u003C/p\u003E"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "f07f6f27-c5a7-4ffd-b1bd-ab476a82a605",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "843858b0-0100-47fd-b77b-c8327efe128f",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "ded5bd46-d7fd-4da6-a764-4ef66ad932c6",
