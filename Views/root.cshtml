@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = null;
}

<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>@Model.Name</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
		<link href="~/css/carousel.css" rel="stylesheet" asp-append-version="true" />
		<link href="~/css/video.css" rel="stylesheet" asp-append-version="true" />
		<link href="~/css/code.css" rel="stylesheet" asp-append-version="true" />
		<link href="~/css/rich-text.css" rel="stylesheet" asp-append-version="true" />
		<link href="~/css/accordion.css" rel="stylesheet" asp-append-version="true" />
		<link href="~/css/portrait.css" rel="stylesheet" asp-append-version="true" />
		<link href="~/css/quote.css" rel="stylesheet" asp-append-version="true" />
		<link href="~/css/graph.css" rel="stylesheet" asp-append-version="true" />
		<link href="~/css/script.css" rel="stylesheet" asp-append-version="true" />
	</head>

	<body>
		@RenderBody()

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
		<script src="~/js/video.js" asp-append-version="true" defer></script>
	</body>
</html>
