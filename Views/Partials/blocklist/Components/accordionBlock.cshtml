@using Umbraco.Cms.Core.Models.Blocks
@using UmbracoKalaset26.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem<AccordionBlock>>

@{
	var items = Model.Content.Items?
		.Select(item => item.Content)
		.OfType<AccordionItem>()
		.Where(item => !string.IsNullOrWhiteSpace(item.Title))
		.ToList() ?? [];
	if (items.Count == 0) { return; }

	// Unique per block, so several accordions on a page (or in the preview) don't toggle each other.
	var id = $"accordion-{Model.ContentKey:N}";
	// Centred in a .container, or full width as a flush (borderless-sided) accordion.
	var fullWidth = Model.Content.FullWidth;
}

@* Bootstrap's accordion (https://getbootstrap.com/docs/5.3/components/accordion/): one panel
   open at a time, the first one open to begin with. *@
<section class="accordion-block @(fullWidth ? "accordion-block--full" : "container")">
	@if (!string.IsNullOrWhiteSpace(Model.Content.Heading))
	{
		<h2 class="accordion-block__heading">@Model.Content.Heading</h2>
	}
	<div class="accordion @(fullWidth ? "accordion-flush" : null)" id="@id">
		@for (var i = 0; i < items.Count; i++)
		{
			var panel = $"{id}-{i}";
			var open = i == 0;
			<div class="accordion-item">
				<h3 class="accordion-header">
					<button class="accordion-button @(open ? null : "collapsed")" type="button" data-bs-toggle="collapse"
							data-bs-target="#@panel" aria-expanded="@(open ? "true" : "false")" aria-controls="@panel">
						@items[i].Title
					</button>
				</h3>
				<div id="@panel" class="accordion-collapse collapse @(open ? "show" : null)" data-bs-parent="#@id">
					<div class="accordion-body rich-text">@items[i].Text</div>
				</div>
			</div>
		}
	</div>
</section>
