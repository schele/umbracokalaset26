<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!--
      Default must match UmbracoAppLocalIcuVersion in UmbracoKalaset26.csproj. Defined here too because this file
      is imported before the main project's own PropertyGroup runs, so under CPM the PackageVersion below needs
      its own fallback to stay in sync with the RuntimeHostConfigurationOption value set from the same property.
    -->
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ColorCode.HTML" Version="2.0.15" />
    <PackageVersion Include="Esatto.Umbraco.Backoffice.AICosts" Version="1.0.2" />
    <PackageVersion Include="Esatto.Umbraco.Backoffice.BlockPreview" Version="1.0.2" />
    <PackageVersion Include="Esatto.Umbraco.Backoffice.CustomEditors" Version="1.1.6" />
    <PackageVersion Include="Esatto.Umbraco.Backoffice.Redirects" Version="1.0.3" />
    <PackageVersion Include="Esatto.Umbraco.Backoffice.SharedPreviewLink" Version="1.0.7" />
    <PackageVersion Include="Esatto.Umbraco.Backoffice.TreeDragAndDrop" Version="1.0.0" />
    <!-- GHSA-qhrr-8q5h-9q3h: Umbraco 18.2.1 allows MessagePack 3.1.8, fixed in 3.1.9. Drop once Umbraco requires >= 3.1.9 (18.3.0 does). -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Umbraco.AI" Version="18.5.2" />
    <PackageVersion Include="Umbraco.AI.Anthropic" Version="18.1.2" />
    <PackageVersion Include="Umbraco.Cms" Version="18.2.1" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="18.2.1" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="$(UmbracoAppLocalIcuVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="uSync" Version="18.1.5" />
  </ItemGroup>
</Project>
